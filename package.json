{
  "name": "promptparcel",
  "version": "0.1.0",
  "description": "A local, verifiable file envelope for any AI chat tab.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/inject.test.mjs test/pack.test.mjs",
